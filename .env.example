# Copy to .env to override the local development defaults.
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=local-app-password
MYSQL_ROOT_PASSWORD=local-root-password

# Backing RustFS object storage credentials
RUSTFS_ACCESS_KEY=local-rustfs
RUSTFS_SECRET_KEY=local-rustfs-password

# S3 storage client configuration for local services
S3_ENDPOINT=http://127.0.0.1:9000
S3_BUCKET=job-files
S3_ACCESS_KEY=local-rustfs
S3_SECRET_KEY=local-rustfs-password
S3_REGION=us-east-1

# Workload container cluster overrides (Docker Desktop Kubernetes)
WORKLOAD_S3_ENDPOINT=http://host.docker.internal:9000
WORKLOAD_JDBC_URL=jdbc:mysql://host.docker.internal:3306/app?rewriteBatchedStatements=true

